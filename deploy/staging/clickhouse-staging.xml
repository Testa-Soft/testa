<clickhouse>
    <!-- Staging: the image ships with logger level "trace" and every system log
         table on. Over two weeks text_log alone reached 16M rows and the memory
         tracker drifted to ~820 GiB against a 1.2 GiB RSS, so ClickHouse refused
         modeler queries and consumer inserts with "Memory limit (total) exceeded". -->
    <logger>
        <level>warning</level>
    </logger>
    <text_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_views_log remove="1"/>
    <query_metric_log remove="1"/>
    <part_log remove="1"/>
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <error_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </error_log>
</clickhouse>
