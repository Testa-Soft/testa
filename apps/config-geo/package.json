{
  "name": "@testa-platform/config-geo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker — splices visitor geo (request.cf) into the config JSON served on config.testa-soft.tech",
  "main": "src/index.ts",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo .wrangler coverage"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20241112.0",
    "typescript": "5.6.3",
    "vitest": "2.1.5",
    "wrangler": "3.86.1"
  }
}
